# HeatMapX Backend Environment Variables (Vercel & Local Development)

# Server Port (Default: 5000; dynamically allocated on Vercel)
PORT=5000

# Node Environment ('production' or 'development')
NODE_ENV=production

# MongoDB Atlas Connection URI (Optional: falls back to built-in in-memory dataset if omitted)
MONGODB_URI=

# Allowed CORS Origins (Optional: comma-separated list of origins, e.g. "https://heatmapx.vercel.app,https://yourdomain.com")
# If omitted, defaults to allowing Vercel preview domains (*.vercel.app) and localhost
CORS_ORIGIN=

# Telecom / SMS OTP Dispatch Gateway (Optional: Sandbox/Mock Mode if omitted)
SMS_PROVIDER_NAME=
SMS_PROVIDER_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email OTP Dispatch Gateway (Optional: Sandbox/Mock Mode if omitted)
EMAIL_PROVIDER_NAME=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SENDGRID_API_KEY=
