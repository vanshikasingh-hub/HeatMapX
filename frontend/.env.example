# HeatMapX Frontend Environment Variables (Vite & Vercel)

# API Base URL Override (Optional)
# In unified Vercel deployment (services architecture), this can be left empty
# or set to '/api' to use the same-origin reverse proxy rewrites.
# If backend is deployed to a separate domain, set the absolute URL:
# VITE_API_URL=https://your-backend-service.vercel.app
VITE_API_URL=
